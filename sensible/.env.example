# Copy to sensible/.env and fill in the values. Never commit .env.

# Grafana admin login (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Read-only AWS credentials used by the Grafana CloudWatch datasource
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
